{
  "name": "gameQ",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "gameq",
  "sourceRoot": "packages/gameQ/src",
  "tags": ["scope:gameQ", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "assets": [
          "packages/gameQ/src/assets",
          {
            "glob": "**/*",
            "input": "packages/gameQ/public"
          }
        ]
      },
      "configurations": {
        "production": {
          "target": "gameQ:esbuild:production"
        },
        "development": {
          "target": "gameQ:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "gameQ:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "cacheExternalArtifacts": false,
        "port": 4202
      },
      "continuous": true
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "buildTarget": "portal:build:development",
        "watch": false,
        "coverage": true,
        "coverageReporters": ["text", "html", "lcov"],
        "coverageExclude": [
          "**/*.harness.ts",
          "**/portal-lib/*"
        ]
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "gameQ:build",
        "port": 4200,
        "staticFilePath": "dist/packages/gameQ/browser",
        "spa": true,
        "proxyConfig": "packages/gameQ/proxy-local.config.js"
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/gameQ",
        "browser": "packages/gameQ/src/main.ts",
        "tsConfig": "packages/gameQ/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "packages/gameQ/src/assets",
          {
            "glob": "**/*",
            "input": "packages/gameQ/public"
          }
        ],
        "styles": [
          "packages/gameQ/src/styles.scss",
          "@angular/material/prebuilt-themes/azure-blue.css",
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "node_modules/ngx-toastr/toastr.css"
        ],
        "scripts": [
          "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
        ],
        "polyfills": [
          "es-module-shims"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "gameQ:esbuild:production"
        },
        "development": {
          "buildTarget": "gameQ:esbuild:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4202,
        "proxyConfig": "packages/gameQ/proxy-local.config.js"
      }
    }
  }
}
